---
import '../../styles/global.css';
const reference = Astro.url.searchParams.get('reference');
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Payment status — FreeCoffee.bio</title></head>
  <body><main class="grid min-h-screen place-items-center bg-muted/30 p-5"><section class="w-full max-w-lg rounded-xl border bg-card p-8 text-center shadow-sm"><h1 class="text-2xl font-semibold">Payment submitted</h1><p class="mt-3 text-sm leading-6 text-muted-foreground">Your payment is being confirmed. We will use the provider notification to update the final status and send your receipt.</p>{reference && <p class="mt-5 break-all font-mono text-xs text-muted-foreground">Reference: {reference}</p>}<a class="mt-6 inline-flex rounded-lg bg-primary px-4 py-2 text-sm text-primary-foreground" href="/">Return home</a></section></main></body>
</html>
