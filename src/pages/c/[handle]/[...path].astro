---
import '../../../styles/global.css';
import geistLatinFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2';
import { ArrowLeft, Coffee, ShoppingBag } from 'lucide-react';
import { getPublicCreator } from '../../../server/creator';
import { getCurrentUser } from '../../../server/session';
import { ToastHost } from '../../../components/toast-host';

const handle = Astro.params.handle;
const path = Astro.params.path?.split('/').filter(Boolean) ?? [];
if (!handle || path.length < 2) return new Response('Not Found', { status: 404 });
const workspace = await getPublicCreator(handle);
if (!workspace) return new Response('Not Found', { status: 404 });
const currentUser = await getCurrentUser(Astro.request);
const [type, id] = path;
const product = type === 'shop' ? workspace.products.find((item) => item.id === id) : null;
if (type !== 'shop' || !product) return new Response('Not Found', { status: 404 });
const title = product.name;
const creatorUrl = `/c/${encodeURIComponent(workspace.creator.handle)}`;
const backLabel = 'Back to shop';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href={geistLatinFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={product.description || title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — {workspace.creator.displayName}</title>
  </head>
  <body>
    <script is:inline>try { if (localStorage.getItem('freecoffee-theme') === 'dark') document.documentElement.classList.add('dark'); } catch {}</script>
    <ToastHost client:load />
    <main class="min-h-screen bg-muted/30 text-foreground">
      <header class="border-b bg-background">
        <div class="mx-auto flex min-h-16 max-w-5xl items-center justify-between gap-4 px-4">
          <a href={creatorUrl} class="flex items-center gap-2 font-semibold tracking-tight">
            <span class="grid size-8 place-items-center rounded-lg bg-primary text-primary-foreground"><Coffee class="size-4" /></span>
            {workspace.creator.displayName}
          </a>
          <a href={creatorUrl} class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground"><ArrowLeft class="size-4" /> {backLabel}</a>
        </div>
      </header>

      <div class="min-h-[90vh]">

      {type === 'shop' && product && <article class="mx-auto max-w-5xl px-4 py-6 sm:py-8">
        <div class="grid gap-5 lg:grid-cols-[minmax(0,1.08fr)_minmax(320px,.92fr)] lg:items-start">
          <section class="overflow-hidden rounded-xl border bg-card shadow-sm">
            <div class="grid aspect-square place-items-center bg-muted">
              <div class="text-center text-muted-foreground"><ShoppingBag class="mx-auto size-16 stroke-[1.4]" /><p class="mt-4 text-sm">Digital product</p></div>
            </div>
            <div class="border-t p-5 sm:p-7"><p class="font-mono text-xs uppercase tracking-[0.12em] text-primary">Shop item</p><h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{product.name}</h1>{product.description && <p class="mt-4 whitespace-pre-wrap text-base leading-7 text-muted-foreground">{product.description}</p>}</div>
          </section>
          <aside class="rounded-xl border bg-card p-5 shadow-sm sm:p-7 lg:sticky lg:top-6">
            <p class="text-sm text-muted-foreground">{workspace.creator.displayName}'s shop</p>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight">{product.name}</h2>
            <p class="mt-5 text-center text-4xl font-semibold tracking-tight">{product.currency === 'USD' ? '$' : `${product.currency} `}{(product.price / 100).toFixed(2)}</p>
            <p class="mt-2 text-center text-sm text-muted-foreground">One-time purchase</p>
            {workspace.paymentProviders.stripe || workspace.paymentProviders.paypal ? <form class="mt-7 grid gap-3" action="/api/shop/create" method="post"><input type="hidden" name="handle" value={workspace.creator.handle} /><input type="hidden" name="productId" value={product.id} /><label class="grid gap-2 text-sm font-medium" for="buyer-email">Email address<input id="buyer-email" required type="email" name="email" value={currentUser?.email ?? ''} placeholder="you@example.com" class="h-11 rounded-lg border bg-background px-3 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30" /></label><label class="grid gap-2 text-sm font-medium" for="payment-provider">Payment method<select id="payment-provider" name="provider" class="h-11 rounded-lg border bg-background px-3 outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30">{workspace.paymentProviders.stripe && <option value="stripe">Card or bank card</option>}{workspace.paymentProviders.paypal && <option value="paypal">PayPal</option>}</select></label><button type="submit" class="inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/80">Buy now <ShoppingBag class="size-4" /></button><p class="text-center text-xs leading-5 text-muted-foreground">Payment is completed securely by the selected provider.</p></form> : <p class="mt-7 rounded-lg bg-muted p-3 text-sm leading-5 text-muted-foreground">Purchases are temporarily unavailable.</p>}
          </aside>
        </div>
      </article>}
      </div>

      <footer class="border-t bg-background">
        <div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-3 px-4 py-5 font-mono text-[14px] text-muted-foreground">
          <a href={creatorUrl}>{workspace.creator.displayName}</a>
          <span>Creator-owned support, made simple.</span>
          <a href="/privacy" class="hover:text-foreground">Privacy</a>
        </div>
      </footer>
    </main>
  </body>
</html>
