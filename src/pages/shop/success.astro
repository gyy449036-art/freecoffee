---
import '../../styles/global.css';



const title = 'Payment being confirmed';
const message = 'Your payment is being confirmed. We will send download links after the provider confirms it.';
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title} — FreeCoffee.bio</title></head>
  <body><main class="grid min-h-screen place-items-center bg-muted/30 p-5"><section class="w-full max-w-lg rounded-xl border bg-card p-8 text-center shadow-sm"><p class="font-mono text-xs uppercase tracking-widest text-primary">Shop order</p><h1 class="mt-3 text-2xl font-semibold">{title}</h1><p class="mt-3 text-sm leading-6 text-muted-foreground">{message}</p><div class="mt-6 rounded-lg bg-muted p-4 text-left text-sm"><p>Order details and download links will be sent to the receipt email you entered after confirmation.</p></div><div class="mt-6 flex flex-wrap justify-center gap-3"><a class="inline-flex rounded-lg bg-primary px-4 py-2 text-sm text-primary-foreground" href="/orders">View my orders</a><a class="inline-flex rounded-lg border px-4 py-2 text-sm hover:bg-muted" href="/">Return home</a></div></section></main></body>
</html>
