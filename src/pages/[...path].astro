---
import '../styles/global.css';
import geistLatinFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2';
import { getAdminPath } from '../lib/config';
import { getSiteSettings } from '../server/site-settings';
import { getCreatorWorkspace } from '../server/creator';
import { getRootUserId } from '../server/admin';
import { requireRoot } from '../server/session';
import { env } from 'cloudflare:workers';
import { AdminIcon } from '../components/admin-icon';
import { ToastHost } from '../components/toast-host';

import { MediaManager } from '../components/media-manager';
import { EmailManager } from '../components/email-manager';
import { NotificationsManager } from '../components/notifications-manager';
import { SystemActivityManager } from '../components/system-activity-manager';
import { PaymentsManager } from '../components/payments-manager';
import { getS3Status, listMedia } from '../server/media';
import { listNotificationDeliveries, listNotificationTemplates } from '../server/notifications';
import { AdminTabs } from '../components/admin-tabs';
import { SocialLinksDialog } from '../components/social-links-dialog';
import { ShareDialog } from '../components/share-dialog';
import { ShopStatusSelect } from '../components/shop-select';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Textarea } from '../components/ui/textarea';
import { createDb } from '../db';
import { and, desc, eq, sql } from 'drizzle-orm';
import { downloadGrants, notificationDeliveries, orders, paymentEvents, products, supportTransactions } from '../db/schema';

const siteSettings = await getSiteSettings();
const paymentConfig = {
  stripe: Boolean(siteSettings.stripeSecretKey && siteSettings.stripeWebhookSecret),
  paypal: Boolean(siteSettings.paypalClientId && siteSettings.paypalClientSecret && siteSettings.paypalWebhookId),
};
const adminPath = getAdminPath((env as unknown as { ADMIN_PATH?: string }).ADMIN_PATH);
const currentPath = Astro.params.path ?? '';
if (!currentPath.startsWith(adminPath)) return new Response('Not Found', { status: 404 });
if (currentPath === `${adminPath}/gallery` || currentPath === `${adminPath}/posts`) return Astro.redirect(`/${adminPath}`);
if (!(await getRootUserId())) return Astro.redirect('/install');
let sessionUser;
try {
  sessionUser = await requireRoot(Astro.request);
} catch {
  return Astro.redirect(`/${adminPath}/login`);
}

const workspace = await getCreatorWorkspace(sessionUser);
const db = createDb(env.DB);
const [shopProducts, supports, creatorOrders, supportSummary, orderSummary, paymentEventLog, downloadGrantLog, mediaStorage, mediaContent, notificationTemplates, notificationDeliveriesLog] = await Promise.all([
  db.select().from(products).where(eq(products.creatorId, workspace.creator.id)).orderBy(desc(products.createdAt)),
  db.select().from(supportTransactions).where(eq(supportTransactions.creatorId, workspace.creator.id)).orderBy(desc(supportTransactions.createdAt)),
  db.select().from(orders).where(eq(orders.creatorId, workspace.creator.id)).orderBy(desc(orders.createdAt)),
  db.select({ amount: sql<number>`coalesce(sum(${supportTransactions.amount}), 0)`, count: sql<number>`count(*)` }).from(supportTransactions).where(and(eq(supportTransactions.creatorId, workspace.creator.id), eq(supportTransactions.status, 'paid'))),
  db.select({ amount: sql<number>`coalesce(sum(${orders.totalAmount}), 0)`, count: sql<number>`count(*)` }).from(orders).where(and(eq(orders.creatorId, workspace.creator.id), eq(orders.status, 'paid'))),
  db.select().from(paymentEvents).orderBy(desc(paymentEvents.receivedAt)).limit(50),
  db.select().from(downloadGrants).orderBy(desc(downloadGrants.createdAt)).limit(100),
  getS3Status(env.DB),
  listMedia(env.DB),
  listNotificationTemplates(),
  listNotificationDeliveries(),
]);
const totalReceived = (supportSummary[0]?.amount ?? 0) + (orderSummary[0]?.amount ?? 0);
const totalTransactions = (supportSummary[0]?.count ?? 0) + (orderSummary[0]?.count ?? 0);
const settingsTab = Astro.url.searchParams.get('tab') ?? 'profile';
const publicSiteUrl = siteSettings.siteUrl?.trim() || '';
const isSettings = currentPath === `${adminPath}/settings`;
const isShop = currentPath === `${adminPath}/shop`;
const isPayments = currentPath === `${adminPath}/payments`;
const isEmail = currentPath === `${adminPath}/email`;
const isNotifications = currentPath === `${adminPath}/notifications`;
const isOperations = currentPath === `${adminPath}/operations`;
const isMedia = currentPath === `${adminPath}/media`;
const pageTitle = isNotifications ? 'Notifications' : isMedia ? 'File management' : isEmail ? 'Email settings' : isPayments ? 'Payments and orders' : isShop ? 'Shop' : isOperations ? 'System activity' : isSettings ? 'Settings' : 'Overview';
const navItems = [
  { label: 'Home', href: `/${adminPath}`, icon: 'home' as const },
  { label: 'Your page', href: '/', icon: 'page' as const },
  // { label: 'Feed', href: `/${adminPath}/feed`, icon: 'feed' as const },
  { label: 'Settings', href: `/${adminPath}/settings`, icon: 'settings' as const },
  { label: 'Email', href: `/${adminPath}/email`, icon: 'mail' as const },
  { label: 'Notifications', href: `/${adminPath}/notifications`, icon: 'alerts' as const },
  { label: 'Files', href: `/${adminPath}/media`, icon: 'files' as const },
  { label: 'System activity', href: `/${adminPath}/operations`, icon: 'activity' as const },
];
const supportItems = [
  { label: 'Payments & orders', href: `/${adminPath}/payments`, icon: 'payments' as const },
  // { label: 'Messages', href: `/${adminPath}/messages`, icon: 'messages' as const },
  // { label: 'My supporters', href: `/${adminPath}/supporters`, icon: 'supporters' as const },
];
const earnItems = [
  // { label: 'Memberships', href: `/${adminPath}/memberships`, icon: 'memberships' as const },
  { label: 'Shop', href: `/${adminPath}/shop`, icon: 'shop' as const },
  // { label: 'Commissions', href: `/${adminPath}/commissions`, icon: 'commissions' as const },
  // { label: 'Buttons & widgets', href: `/${adminPath}/widgets`, icon: 'widgets' as const },
  // { label: 'Discord', href: `/${adminPath}/discord`, icon: 'discord' as const },
  // { label: 'Stream alerts', href: `/${adminPath}/alerts`, icon: 'alerts' as const },
  // { label: 'Promote your page', href: `/${adminPath}/promote`, icon: 'promote' as const },
  // { label: 'More', href: `/${adminPath}/more`, icon: 'more' as const },
];

function isActive(label: string) {
  return (label === 'Settings' && isSettings) || (label === 'Email' && isEmail) || (label === 'Notifications' && isNotifications) || (label === 'Files' && isMedia) || (label === 'Shop' && isShop) || (label === 'System activity' && isOperations) || (label === 'Payments & orders' && isPayments) || (label === 'Home' && currentPath === adminPath);
}
---
<html lang="en" class="admin-page">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><link rel="preload" href={geistLatinFont} as="font" type="font/woff2" crossorigin /><style is:inline>html { font-family: 'Geist Variable', Arial, sans-serif; } .admin-body { font-size: 16px; }</style><title>{pageTitle} — FreeCoffee.bio</title><script is:inline>try { if (localStorage.getItem('freecoffee-theme') === 'dark') document.documentElement.classList.add('dark'); } catch {}</script></head>
  <body class="admin-body">
    <ToastHost client:load />
    <div class="admin-shell">
      <aside class="admin-sidebar" id="admin-sidebar">
        <a class="admin-brand" href={`/${adminPath}`} aria-label="FreeCoffee home"><span class="brand-mark"><AdminIcon name="coffee" size={20} /></span><span>FreeCoffee</span><b>.bio</b></a>
        <nav class="admin-nav" aria-label="Main navigation">
          {navItems.map((item) => <a class:list={['admin-nav-item', { 'is-active': isActive(item.label) }]} href={item.href}><span class="admin-nav-icon"><AdminIcon name={item.icon} /></span><span>{item.label}</span></a>)}
          {supportItems.length > 0 && <p class="admin-nav-label">My support</p>}
          {supportItems.map((item) => <a class="admin-nav-item" href={item.href}><span class="admin-nav-icon"><AdminIcon name={item.icon} /></span><span>{item.label}</span></a>)}
          {earnItems.length > 0 && <p class="admin-nav-label">More ways to earn</p>}
          {earnItems.map((item) => <a class:list={['admin-nav-item', { 'is-active': isActive(item.label) }]} href={item.href}><span class="admin-nav-icon"><AdminIcon name={item.icon} /></span><span>{item.label}</span></a>)}
        </nav>
        <ShareDialog client:load url={publicSiteUrl} displayName={workspace.creator.displayName} />
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <Button className="admin-menu-button" type="button" data-menu-toggle aria-label="Open navigation"><AdminIcon name="menu" size={21} /></Button>
          <div class="admin-top-actions">
            <a class="page-pill" href="/" target="_blank" rel="noreferrer"><span class="mini-avatar"><AdminIcon name="page" size={14} /></span> Your page</a>
            <Button className="top-icon" variant="ghost" type="button" aria-label="Notifications"><AdminIcon name="alerts" size={19} /></Button>
            <Button className="top-icon theme-icon" variant="ghost" type="button" data-theme-toggle aria-label="Switch to dark mode"><span data-theme-light><AdminIcon name="sun" size={19} /></span><span data-theme-dark><AdminIcon name="moon" size={19} /></span></Button>
            <Button className="top-icon" variant="ghost" type="button" data-logout aria-label="Sign out"><AdminIcon name="logout" size={19} /></Button>
          </div>
        </header>

        <main class="admin-content">
          {isNotifications ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Messaging</p><h1>Notifications</h1><p>Manage reusable message templates and review delivery activity across channels.</p></div>
              <NotificationsManager client:load initialTemplates={notificationTemplates} initialDeliveries={notificationDeliveriesLog} />
            </>
          ) : isMedia ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Creator tools</p><h1>File management</h1><p>Store images and files in your S3-compatible object storage.</p></div>
              <MediaManager client:load initialStorage={mediaStorage} initialFiles={mediaContent} />
            </>
          ) : isEmail ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Delivery</p><h1>Email settings</h1><p>Configure SMTP delivery for receipts and creator notifications.</p></div>
              <EmailManager client:load initialSettings={workspace.email} />
            </>
          ) : isOperations ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Reliability</p><h1>System activity</h1><p>Inspect provider webhooks and download access. Internal records are visible to root administrators.</p></div>
              <SystemActivityManager client:load paymentEvents={paymentEventLog} downloadGrants={downloadGrantLog} />
            </>
          ) : isPayments ? (
            <>
              <div class="admin-heading"><h1>Payments and orders</h1><p>Review tips and shop orders in one place.</p></div>
              <PaymentsManager client:load supports={supports} orders={creatorOrders} />
            </>
          ) : isShop ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Creator tools</p><h1>Shop</h1><p>Sell digital or physical items in your own shop.</p></div>
              <AdminTabs client:load group="shop" activeTab={settingsTab === 'orders' ? 'orders' : 'setup'} tabs={[{ value: 'setup', label: 'Setup' }, { value: 'orders', label: 'Orders' }]} />
              <div class="settings-panels" data-settings-panels="shop">
              <div data-admin-panel="setup" hidden={settingsTab === 'orders'}>
              <a class="shop-video" href="#products"><span class="video-thumb"><AdminIcon name="shop" size={17} /></span><strong>Video: Setting up your shop</strong><span>→</span></a>
              <section class="shop-card shop-status-card"><h2>Status</h2><p>Show or hide your shop tab on your page.</p><ShopStatusSelect client:load /></section>
              <section class="shop-card" id="products"><div class="shop-card-heading"><div><h2>Products <span class="hint"><AdminIcon name="info" size={14} /></span></h2></div></div><form class="profile-form" data-product-form><label>Product name<Input name="name" required maxLength="160" /></label><label>Description<Textarea name="description" rows="2" /></label><label>Price (USD cents)<Input name="price" type="number" min="0" step="1" required /></label><p class="field-help">New products start as drafts. Upload a digital file before publishing.</p><Button className="dark-button" type="submit"><AdminIcon name="plus" size={16} /> Add product</Button><p class="form-status" data-product-status role="status"></p></form>{shopProducts.length ? shopProducts.map((product) => <div class="product-row"><div class="product-thumb"><AdminIcon name="coffee" size={25} /></div><div class="product-copy"><strong>{product.name}</strong><span>Digital · {product.status}</span><small>{(product.price / 100).toFixed(2)} {product.currency}</small></div><span>{product.status}</span><div class="product-actions"><Button type="button" data-product-status={product.id} data-next-status={product.status === 'published' ? 'draft' : 'published'}>{product.status === 'published' ? 'Unpublish' : 'Publish'}</Button><form action="/api/admin/files" method="post" enctype="multipart/form-data"><input type="hidden" name="productId" value={product.id} /><input name="file" type="file" required aria-label={`Upload file for ${product.name}`} /><Button type="submit">Upload</Button></form></div></div>) : <div class="payments-empty"><div class="empty-coffee"><AdminIcon name="shop" size={24} /></div><h2>No products yet</h2><p>Create a product to publish your first digital item.</p></div>}</section>
              <section class="shop-card"><h2>Contact details</h2><p>Add an email so buyers can contact you about their order. This setting is used for both Shop and Commissions.</p><Input className="shop-input" type="email" defaultValue={sessionUser.email} readOnly aria-label="Contact email" /></section>
              <section class="shop-card"><h2>Categories</h2><p>Group your products into categories so buyers can filter your shop.</p><div class="shop-empty-row"><span>No categories yet</span><Button type="button">Add categories</Button></div></section>
              <section class="shop-card"><h2>Sharing</h2><h3>Preview image</h3><p>Add a preview image for sharing your shop on social media. We recommend a 2:1 ratio. <span class="hint">(optional)</span></p><div class="shop-empty-row"><span>No preview image yet</span><Button type="button">Browse…</Button></div></section>
              <section class="shop-card"><h2>Additional settings</h2><label class="check-row"><input type="checkbox" /> Ask your buyer for their telephone number when an item includes shipping <span class="hint">ⓘ</span></label><label class="check-row"><input type="checkbox" /> Purchases unlock supporter-only content</label></section>
              <section class="shop-card"><h2>Your terms</h2><p>These terms apply to all of your products. Tell your buyers about your refund/cancellation policy, delivery details and any licence conditions. <a href="#terms">Read more</a></p><Textarea className="shop-input" rows="5" placeholder="e.g. refund policy, cancellation, lead times, licence" /></section>
              <section class="shop-card shop-small-card"><h2>Discounts</h2><p>Promote your shop with shareable <a href="#discounts">discounts</a></p></section>
              <section class="shop-card shop-small-card"><h2>Sales tax</h2><p>Sales tax If you charge sales tax, you can manage that <a href="#tax">here</a></p></section>
              <section class="shop-card shop-small-card"><h2>Feedback</h2><p>We love your feedback! Let us know what you think <a href="#feedback">here</a> or read our FAQs <a href="#faqs">here</a></p></section>
              </div>
              <section class="payments-card" data-admin-panel="orders" hidden={settingsTab !== 'orders'}><h2>Orders</h2>{creatorOrders.length ? <div class="activity-list">{creatorOrders.map((item) => <div class="activity-row"><span><strong>{item.buyerEmail}</strong><small>{item.status} · {item.provider || 'pending'} · {item.createdAt.toISOString()}</small></span><b>{(item.totalAmount / 100).toFixed(2)} {item.currency}</b></div>)}</div> : <div class="payments-empty"><div class="empty-coffee"><AdminIcon name="shop" size={24} /></div><h2>No orders yet</h2><p>Orders will appear here after a customer makes a purchase.</p></div>}</section>
              </div>
            </>
          ) : isSettings ? (
            <>
              <div class="admin-heading"><p class="admin-kicker">Workspace</p><h1>Settings</h1><p>Shape how your page looks and how supporters can reach you.</p></div>
              <AdminTabs client:load group="settings" activeTab={settingsTab} tabs={[{ value: 'profile', label: 'Profile' }, { value: 'payment', label: 'Payment' }, { value: 'page', label: 'Page' }]} />
              <div class="settings-panels" data-settings-panels="settings">
                <section class="settings-card" data-admin-panel="profile" hidden={settingsTab !== 'profile'}>
                  <div class="profile-photo"><div class="profile-avatar"><AdminIcon name="coffee" size={42} /></div><Button type="button">Change photo</Button></div>
                  <form class="profile-form" data-profile-form>
                    <label><span class="field-label">Display name <span class="hint"><AdminIcon name="info" size={14} /></span></span><Input defaultValue={workspace.creator.displayName} name="displayName" /></label>
                    <label><span class="field-label">Username <span class="hint"><AdminIcon name="info" size={14} /></span></span><div class="input-with-button"><Input defaultValue={workspace.creator.handle} name="handle" /><Button type="button">Set</Button></div></label>
                    <label><span class="field-label">About you <span class="hint"><AdminIcon name="info" size={14} /></span></span><Textarea name="bio" rows="5" defaultValue={workspace.creator.bio ?? ''} placeholder="Tell supporters what you make and why it matters." /></label>
                    <label><span class="field-label">What do you do? <span class="hint"><AdminIcon name="info" size={14} /></span></span><div class="tag-input"><span>Creator <Button type="button" variant="ghost" size="icon" aria-label="Remove tag"><AdminIcon name="close" size={13} /></Button></span></div></label>
                    <label><span class="field-label">Site URL <span class="hint"><AdminIcon name="info" size={14} /></span></span><div class="input-with-button"><Input defaultValue={siteSettings.siteUrl || Astro.url.origin} name="siteUrl" type="url" placeholder="https://your-domain.com" /><Button type="submit">Save</Button></div><span class="field-help">Use the site origin only. Do not include <code>/{adminPath}</code> or a callback path.</span></label><label><span class="field-label">Website <span class="hint"><AdminIcon name="info" size={14} /></span></span><Input name="website" type="url" defaultValue={workspace.creator.website ?? ''} placeholder="https://" /></label>
                    <SocialLinksDialog client:load handle={workspace.creator.handle} displayName={workspace.creator.displayName} bio={workspace.creator.bio} website={workspace.creator.website} initialLinks={workspace.creator.socialLinks} />
                    <hr />
                    <div class="connected-heading"><h2>Connected accounts</h2><p>Link platforms you use for streaming and content.</p></div>
                    {[{ label: 'X', icon: 'x' as const }, { label: 'Twitch', icon: 'twitch' as const }, { label: 'YouTube', icon: 'youtube' as const }].map((account) => <div class="connected-row"><span class="connected-account"><AdminIcon name={account.icon} size={16} /> {account.label}</span><Button type="button" variant="outline">Connect</Button></div>)}
                    <Button className="save-button" type="submit">Save changes</Button><p class="form-status" data-form-status role="status"></p>
                  </form>
                </section>
                <section class="settings-card" data-admin-panel="payment" hidden={settingsTab !== 'payment'}>
                  <div class="connected-heading"><h2>Payment provider settings</h2><p>Provider credentials are stored in D1 and never displayed after saving.</p></div><form class="profile-form" data-payment-settings-form><h3>Stripe</h3><label>Secret key<Input name="stripeSecretKey" type="password" placeholder={paymentConfig.stripe ? 'Saved' : 'sk_test_...'} /></label><label>Webhook signing secret<Input name="stripeWebhookSecret" type="password" placeholder={paymentConfig.stripe ? 'Saved' : 'whsec_...'} /></label><h3>PayPal sandbox</h3><label>Client ID<Input name="paypalClientId" type="password" placeholder={paymentConfig.paypal ? 'Saved' : 'Client ID'} /></label><label>Client secret<Input name="paypalClientSecret" type="password" placeholder={paymentConfig.paypal ? 'Saved' : 'Client secret'} /></label><label>Webhook ID<Input name="paypalWebhookId" type="password" placeholder={paymentConfig.paypal ? 'Saved' : 'Webhook ID'} /></label><Button className="save-button" type="submit">Save payment settings</Button><p class="form-status" data-payment-settings-status role="status"></p></form><hr /><div class="connected-heading"><h2>Connected accounts</h2><p>Creator account connection status is stored separately.</p></div>{['stripe', 'paypal'].map((provider) => { const account = workspace.paymentAccounts.find((item) => item.provider === provider); return <div class="connected-row"><span class="connected-account">{provider === 'stripe' ? 'Stripe' : 'PayPal'} <small>{account?.status === 'connected' ? 'Connected' : 'Not connected'}</small></span><Button type="button" variant="outline" data-payment-provider={provider} data-payment-status={account?.status === 'connected' ? 'not_connected' : 'connected'}>{account?.status === 'connected' ? 'Disconnect' : 'Mark connected'}</Button></div>; })}<hr /><div class="connected-heading"><h2>Crypto wallets</h2><p>Wallet configuration is reserved for the final payment phase.</p></div>{workspace.wallets.length ? workspace.wallets.map((wallet) => <div class="connected-row"><span class="connected-account">{wallet.network} · {wallet.asset}</span><span>{wallet.enabled ? 'Enabled' : 'Disabled'}</span></div>) : <p class="field-help">No wallets configured yet.</p>}</section>
                <section class="settings-card" data-admin-panel="page" hidden={settingsTab !== 'page'}>
                  <div class="connected-heading"><h2>Page settings</h2><p>Control the public page message, support options, and shop visibility.</p></div><form class="profile-form" data-page-form><input type="hidden" name="handle" value={workspace.creator.handle} /><input type="hidden" name="displayName" value={workspace.creator.displayName} /><label>Theme color<input name="themeColor" type="color" value={workspace.page?.themeColor ?? '#111111'} /></label><label>Welcome message<Textarea name="welcomeMessage" rows="4" defaultValue={workspace.page?.welcomeMessage ?? ''} /></label><label>Default support amount<Input name="defaultSupportAmount" type="number" min="1" max="1000000" step="1" defaultValue={(workspace.page?.defaultSupportAmount ?? 500) / 100} /></label><label class="check-row"><input name="allowAnonymous" type="checkbox" checked={workspace.page?.allowAnonymous ?? true} /> Allow anonymous support</label><label class="check-row"><input name="showSupport" type="checkbox" checked={workspace.page?.showSupport ?? true} /> Show support form</label><label class="check-row"><input name="showShop" type="checkbox" checked={workspace.page?.showShop ?? true} /> Show shop</label><hr /><div class="connected-heading"><h2>Support goal</h2><p>Show supporters what you are working toward.</p></div><label class="check-row"><input name="supportGoalEnabled" type="checkbox" checked={workspace.page?.supportGoalEnabled ?? false} /> Show support goal</label><label>Goal title<Input name="supportGoalTitle" defaultValue={workspace.page?.supportGoalTitle ?? ''} placeholder="Support open source development" /></label><label>Goal amount<Input name="supportGoalAmount" type="number" min="1" step="1" defaultValue={workspace.page?.supportGoalAmount ? workspace.page.supportGoalAmount / 100 : ''} placeholder="100" /></label><label>Goal description<Textarea name="supportGoalDescription" rows="4" defaultValue={workspace.page?.supportGoalDescription ?? ''} placeholder="Tell supporters what this goal will fund." /></label><label>Terms<Textarea name="terms" rows="5" defaultValue={workspace.page?.terms ?? ''} /></label><Button className="save-button" type="submit">Save page settings</Button><p class="form-status" data-page-status role="status"></p></form>
                </section>
              </div>
            </>
          ) : (
            <>
              <div class="admin-heading"><p class="admin-kicker">Admin / overview</p><h1>Good to see you, {sessionUser.name.split(' ')[0]}.</h1><p>Your creator workspace, at a glance.</p></div>
              <section class="welcome-card"><div><p class="card-eyebrow">Your page is ready for its first visitor</p><h2>Make it yours.</h2><p>Complete your profile so supporters know who they’re backing.</p><a class="primary-button" href={`/${adminPath}/settings`}>Set up your page <span>→</span></a></div><div class="welcome-orbit">☕</div></section>
              <div class="overview-grid"><article class="metric-card"><span>Support received</span><strong>${(totalReceived / 100).toFixed(2)}</strong><small>Across support and shop</small></article><article class="metric-card"><span>Transactions</span><strong>{totalTransactions}</strong><small>Support and orders</small></article><article class="metric-card"><span>Page visits</span><strong>—</strong><small>Coming soon</small></article></div>
              <section class="activity-card"><div class="section-title"><div><p class="admin-kicker">Latest</p><h2>Activity</h2></div><a href={`/${adminPath}/payments`}>View all →</a></div><div class="empty-state"><span>☕</span><h3>Your activity will appear here</h3><p>When someone supports your work, you’ll see it in this space.</p></div></section>
            </>
          )}
        </main>
      </div>
    </div>
    <script is:inline>
      const showToast = (message, type = 'error') => window.dispatchEvent(new CustomEvent('freecoffee:toast', { detail: { message, type } }));
      window.addEventListener('freecoffee:admin-tab-change', (event) => { const { group, value } = event.detail; const container = document.querySelector(`[data-settings-panels="${group}"]`); container?.querySelectorAll('[data-admin-panel]').forEach((panel) => { panel.hidden = panel.dataset.adminPanel !== value; }); });
      const sidebar = document.querySelector('#admin-sidebar');
      document.querySelector('[data-menu-toggle]')?.addEventListener('click', () => sidebar?.classList.toggle('is-open'));
      sidebar?.querySelectorAll('a[href]').forEach((link) => link.addEventListener('click', () => sidebar.classList.remove('is-open')));
      const themeToggle = document.querySelector('[data-theme-toggle]');
      const updateThemeButton = () => { const dark = document.documentElement.classList.contains('dark'); themeToggle?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode'); };
      updateThemeButton();
      themeToggle?.addEventListener('click', () => { const dark = !document.documentElement.classList.contains('dark'); document.documentElement.classList.toggle('dark', dark); try { localStorage.setItem('freecoffee-theme', dark ? 'dark' : 'light'); } catch {} updateThemeButton(); });
      document.querySelector('[data-logout]')?.addEventListener('click', async () => { window.location.href = '/api/auth/logout'; });
      document.querySelector('[data-profile-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const data = new FormData(form); const profileResponse = await fetch('/api/admin/creator', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ handle: data.get('handle'), displayName: data.get('displayName'), bio: data.get('bio'), website: data.get('website') }) }); const siteResponse = await fetch('/api/admin/settings', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ siteUrl: data.get('siteUrl') }) }); if (profileResponse.ok && siteResponse.ok) window.location.reload(); else { const result = await profileResponse.json().catch(() => ({})); showToast(result.error || 'Unable to save settings.'); } }); document.querySelector('[data-email-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const data = new FormData(form); const response = await fetch('/api/admin/email', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ host: data.get('host'), port: data.get('port'), username: data.get('username'), password: data.get('password'), fromAddress: data.get('fromAddress'), replyTo: data.get('replyTo'), secure: data.get('secure') === 'on', enabled: data.get('enabled') === 'on' }) }); if (response.ok) window.location.reload(); else { const result = await response.json().catch(() => ({})); showToast(result.error || 'Unable to save email settings.'); } }); document.querySelector('[data-email-test-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const to = new FormData(form).get('to'); const response = await fetch('/api/admin/email-test', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ to }) }); if (response.ok) showToast('Test email sent.', 'success'); else showToast((await response.json().catch(() => ({}))).error || 'Unable to send test email.'); }); document.querySelector('[data-product-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const data = new FormData(form); const response = await fetch('/api/admin/products', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name: data.get('name'), description: data.get('description'), price: Number(data.get('price')), status: 'draft' }) }); if (response.ok) window.location.reload(); else showToast((await response.json().catch(() => ({}))).error || 'Unable to create product.'); }); document.querySelectorAll('[data-product-status]').forEach((button) => button.addEventListener('click', async () => { const response = await fetch('/api/admin/products', { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: button.dataset.productStatus, status: button.dataset.nextStatus }) }); if (response.ok) window.location.reload(); })); document.querySelector('[data-page-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const data = new FormData(form); const response = await fetch('/api/admin/creator', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ handle: data.get('handle'), displayName: data.get('displayName'), themeColor: data.get('themeColor'), welcomeMessage: data.get('welcomeMessage'), defaultSupportAmount: Math.round(Number(data.get('defaultSupportAmount')) * 100), allowAnonymous: data.get('allowAnonymous') === 'on', showSupport: data.get('showSupport') === 'on', showShop: data.get('showShop') === 'on', supportGoalEnabled: data.get('supportGoalEnabled') === 'on', supportGoalTitle: data.get('supportGoalTitle'), supportGoalAmount: Math.round(Number(data.get('supportGoalAmount')) * 100), supportGoalDescription: data.get('supportGoalDescription'), terms: data.get('terms') }) }); if (response.ok) window.location.reload(); else { const result = await response.json().catch(() => ({})); showToast(result.error || 'Unable to save page settings.'); } }); document.querySelector('[data-payment-settings-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const data = new FormData(form); const response = await fetch('/api/admin/payment-settings', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ stripeSecretKey: data.get('stripeSecretKey'), stripeWebhookSecret: data.get('stripeWebhookSecret'), paypalClientId: data.get('paypalClientId'), paypalClientSecret: data.get('paypalClientSecret'), paypalWebhookId: data.get('paypalWebhookId') }) }); if (response.ok) window.location.reload(); else { const result = await response.json().catch(() => ({})); showToast(result.error || 'Unable to save payment settings.'); } }); document.querySelectorAll('[data-payment-provider]').forEach((button) => button.addEventListener('click', async () => { const response = await fetch('/api/admin/payment-accounts', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ provider: button.dataset.paymentProvider, status: button.dataset.paymentStatus }) }); if (response.ok) window.location.reload(); }));
      const contentForm = (selector, type, fields) => document.querySelector(selector)?.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(event.currentTarget); const body = { type }; fields.forEach((field) => { body[field] = data.get(field); }); const response = await fetch('/api/admin/content', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }); if (response.ok) window.location.reload(); else showToast((await response.json().catch(() => ({}))).error || 'Unable to create content.'); });
      contentForm('[data-gallery-form]', 'gallery', ['title', 'description', 'imageUrl', 'linkUrl']);

      document.querySelectorAll('[data-content-id]').forEach((button) => button.addEventListener('click', async () => { const response = await fetch('/api/admin/content', { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ type: button.dataset.contentType, id: button.dataset.contentId, status: button.dataset.contentStatus }) }); if (response.ok) window.location.reload(); else showToast((await response.json().catch(() => ({}))).error || 'Unable to update content.'); }));
    </script>
  </body>
</html>
